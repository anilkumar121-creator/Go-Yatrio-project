{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/*"],
      "@goyatrio/ui": ["packages/ui/src/index.ts"],
      "@goyatrio/types": ["packages/types/src/index.ts"],
      "@goyatrio/config": ["packages/config/src/index.ts"],
      "@goyatrio/utils": ["packages/utils/src/index.ts"],
      "@goyatrio/database": ["packages/database/src/index.ts"]
    }
  }
}
