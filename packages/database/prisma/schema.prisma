generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum PackageType {
  DOMESTIC
  INTERNATIONAL
  LUXURY
  ADVENTURE
  PILGRIMAGE
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum InquiryServiceType {
  DOMESTIC_TOUR
  INTERNATIONAL_TOUR
  LUXURY_TRAVEL
  ADVENTURE_TRIP
  PILGRIMAGE_PACKAGE
  HOTEL_BOOKING
  CAB_BOOKING
  GENERAL_INQUIRY
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  TEMPO_TRAVELLER
  BUS
  LUXURY
}

enum MediaResourceType {
  IMAGE
  VIDEO
  RAW
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
}

enum HotelStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum HotelCategory {
  BUDGET
  STANDARD
  PREMIUM
  LUXURY
}

enum HotelInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Destination {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  shortDescription String
  description      String
  state            String?
  country          String            @default("India")
  featuredImage    String?
  galleryImages    String[]
  featured         Boolean           @default(false)
  status           DestinationStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  packages         TourPackage[]
  hotels           Hotel[]

  @@index([status, featured, isActive])
  @@map("destinations")
}

model TourPackage {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  shortDescription String
  description      String
  destinationId    String
  durationDays     Int
  durationNights   Int
  priceFrom        Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  packageType      PackageType
  inclusions       String[]
  exclusions       String[]
  featuredImage    String?
  galleryImages    String[]
  featured         Boolean         @default(false)
  status           PackageStatus   @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  destination      Destination     @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itineraries      Itinerary[]
  inquiries        TravelInquiry[]
  hotels           Hotel[]

  @@index([destinationId])
  @@index([status, featured, isActive, packageType])
  @@map("tour_packages")
}

model Itinerary {
  id          String         @id @default(cuid())
  packageId   String
  title       String
  slug        String         @unique
  description String?
  isDefault   Boolean        @default(true)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  package     TourPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  days        ItineraryDay[]

  @@index([packageId])
  @@map("itineraries")
}

model ItineraryDay {
  id          String        @id @default(cuid())
  itineraryId String
  dayNumber   Int
  sortOrder   Int           @default(0)
  title       String
  description String
  city        String?
  hotel       String?
  meals       String?
  transfers   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  itinerary   Itinerary     @relation(fields: [itineraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activities  DayActivity[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@map("itinerary_days")
}

model DayActivity {
  id          String       @id @default(cuid())
  dayId       String
  title       String
  description String?
  location    String?
  timing      String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  day         ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([dayId])
  @@map("day_activities")
}

model Hotel {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  shortDescription String
  fullDescription  String
  destinationId    String
  address          String
  city             String
  state            String?
  country          String          @default("India")
  latitude         Float?
  longitude        Float?
  hotelCategory    HotelCategory   @default(STANDARD)
  starRating       Int             @default(3)
  featured         Boolean         @default(false)
  status           HotelStatus     @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  destination      Destination     @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images           HotelImage[]
  amenities        HotelAmenity[]
  roomTypes        HotelRoomType[]
  inquiries        HotelInquiry[]
  packages         TourPackage[]

  @@index([destinationId])
  @@index([status, featured, hotelCategory, starRating])
  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([hotelId])
  @@map("hotel_images")
}

model HotelAmenity {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotels    Hotel[]

  @@map("hotel_amenities")
}

model HotelRoomType {
  id              String   @id @default(cuid())
  hotelId         String
  roomName        String
  roomDescription String
  maxGuests       Int      @default(2)
  bedType         String
  roomSize        String?
  priceFrom       Decimal  @db.Decimal(12, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([hotelId])
  @@map("hotel_room_types")
}

model HotelInquiry {
  id           String             @id @default(cuid())
  hotelId      String
  customerName String
  email        String
  phone        String
  checkInDate  DateTime
  checkOutDate DateTime
  guests       Int                @default(1)
  message      String?
  status       HotelInquiryStatus @default(NEW)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([hotelId])
  @@index([status, createdAt])
  @@map("hotel_inquiries")
}

model Vehicle {
  id          String      @id @default(cuid())
  vehicleName String
  vehicleType VehicleType
  description String
  capacity    Int
  priceFrom   Decimal     @db.Decimal(12, 2)
  currency    String      @default("INR")
  image       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive, vehicleType])
  @@map("vehicles")
}

model TravelInquiry {
  id                String             @id @default(cuid())
  fullName          String
  email             String
  phone             String
  travelDate        DateTime?
  numberOfTravelers Int?
  destination       String?
  packageId         String?
  serviceType       InquiryServiceType
  budget            Decimal?           @db.Decimal(12, 2)
  message           String?
  status            InquiryStatus      @default(NEW)
  source            String             @default("website")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  package           TourPackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([packageId])
  @@map("travel_inquiries")
}

model Blog {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  featuredImage  String?
  author         String
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("blogs")
}

model Media {
  id           String            @id @default(cuid())
  publicId     String            @unique
  url          String
  secureUrl    String
  resourceType MediaResourceType
  format       String?
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([resourceType])
  @@map("media")
}

model SeoMetadata {
  id             String   @id @default(cuid())
  pageType       String
  entityType     String?
  entityId       String?
  title          String
  description    String
  canonicalUrl   String?
  ogImage        String?
  robots         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageType, entityType, entityId])
  @@map("seo_metadata")
}
