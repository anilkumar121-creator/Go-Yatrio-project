generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum PackageType {
  DOMESTIC
  INTERNATIONAL
  LUXURY
  ADVENTURE
  PILGRIMAGE
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

enum PackageAvailability {
  AVAILABLE
  LIMITED_SEATS
  SOLD_OUT
  UPCOMING
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum InquiryServiceType {
  DOMESTIC_TOUR
  INTERNATIONAL_TOUR
  LUXURY_TRAVEL
  ADVENTURE_TRIP
  PILGRIMAGE_PACKAGE
  HOTEL_BOOKING
  CAB_BOOKING
  GENERAL_INQUIRY
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  TEMPO_TRAVELLER
  BUS
  LUXURY
  LUXURY_SUV
  MINI_BUS
}

enum CabTripType {
  LOCAL
  AIRPORT_TRANSFER
  RAILWAY_TRANSFER
  OUTSTATION
  ONE_WAY
  ROUND_TRIP
  MULTI_DAY
}

enum CabFuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
}

enum CabStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CabInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogContentFormat {
  PLAIN_TEXT
  MARKDOWN
  HTML
  JSON_BLOCKS
}

enum MediaResourceType {
  IMAGE
  VIDEO
  RAW
}

enum MediaStatus {
  ACTIVE
  ARCHIVED
}

enum MediaModule {
  DESTINATION
  PACKAGE
  HOTEL
  CAB
  BLOG
  HOMEPAGE
}

enum MediaLinkRole {
  FEATURED
  GALLERY
  VIDEO
  DOCUMENT
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
}

enum HotelStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum HotelCategory {
  BUDGET
  STANDARD
  PREMIUM
  LUXURY
}

enum HotelInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// Phase 16: Inquiry & Lead Management enums
enum InquiryStatusNew {
  NEW
  CONTACTED
  FOLLOW_UP
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquirySource {
  WEBSITE
  PACKAGE_PAGE
  HOTEL_PAGE
  CAB_PAGE
  CONTACT_FORM
  BLOG_PAGE
  WHATSAPP
  PHONE
  EMAIL
  MANUAL
}

enum InquiryType {
  TOUR_PACKAGE
  HOTEL
  CAB
  GENERAL
  CUSTOM_TOUR
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Destination {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  shortDescription String
  description      String
  state            String?
  country          String            @default("India")
  featuredImage    String?
  galleryImages    String[]
  featured         Boolean           @default(false)
  status           DestinationStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  packages         TourPackage[]
  hotels           Hotel[]
  vehicles         Vehicle[]
  blogs            Blog[]

  @@index([status, featured, isActive])
  @@map("destinations")
}

model TourPackage {
  id               String                 @id @default(cuid())
  title            String
  slug             String                 @unique
  shortDescription String
  description      String
  destinationId    String
  durationDays     Int
  durationNights   Int
  priceFrom        Decimal                @db.Decimal(12, 2)
  discountedPrice  Decimal?               @db.Decimal(12, 2)
  currency         String                 @default("INR")
  packageType      PackageType
  inclusions       String[]
  exclusions       String[]
  featuredImage    String?
  galleryImages    String[]
  featured         Boolean                @default(false)
  status           PackageStatus          @default(DRAFT)
  availability     PackageAvailability    @default(AVAILABLE)
  availableSeats   Int                    @default(0)
  priceValidFrom   DateTime?
  priceValidTo     DateTime?
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  destination      Destination            @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itineraries      Itinerary[]
  inquiries        TravelInquiry[]
  hotels           Hotel[]
  vehicles         Vehicle[]
  blogs            Blog[]
  seasonalPrices   PackageSeasonalPrice[]
  offers           PackageOffer[]

  @@index([destinationId])
  @@index([status, featured, isActive, packageType])
  @@index([availability])
  @@map("tour_packages")
}

model Itinerary {
  id          String      @id @default(cuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  location    String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activities  Activity[]

  @@unique([packageId, dayNumber])
  @@index([packageId])
  @@map("itineraries")
}

model Activity {
  id          String    @id @default(cuid())
  itineraryId String
  title       String
  description String?
  location    String?
  timing      String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([itineraryId])
  @@map("activities")
}

model Hotel {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  shortDescription String
  fullDescription  String
  destinationId    String
  address          String
  city             String
  state            String?
  country          String         @default("India")
  hotelCategory    HotelCategory
  starRating       Int            @default(3)
  featured         Boolean        @default(false)
  status           HotelStatus    @default(DRAFT)
  amenities        String[]
  images           String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  destination      Destination    @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  packages         TourPackage[]
  roomTypes        RoomType[]
  inquiries        HotelInquiry[]

  @@index([destinationId])
  @@index([status, featured, hotelCategory])
  @@map("hotels")
}

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  description String?
  maxGuests   Int
  bedType     String
  roomSize    String?
  priceFrom   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([hotelId])
  @@map("room_types")
}

model HotelInquiry {
  id        String             @id @default(cuid())
  hotelId   String
  name      String
  email     String
  phone     String
  checkIn   DateTime
  checkOut  DateTime
  adults    Int
  children  Int
  rooms     Int
  message   String?
  status    HotelInquiryStatus @default(NEW)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  hotel     Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([hotelId, status])
  @@map("hotel_inquiries")
}

model Vehicle {
  id              String        @id @default(cuid())
  vehicleName     String
  slug            String        @unique
  vehicleType     VehicleType
  description     String?
  capacity        Int
  luggageCapacity Int
  ac              Boolean       @default(true)
  fuelType        CabFuelType
  driverAllowance Decimal       @db.Decimal(10, 2)
  baseFare        Decimal       @db.Decimal(10, 2)
  extraKmCharge   Decimal       @db.Decimal(10, 2)
  nightCharge     Decimal       @db.Decimal(10, 2)
  priceFrom       Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  image           String?
  galleryImages   String[]
  tripTypes       CabTripType[]
  featured        Boolean       @default(false)
  status          CabStatus     @default(DRAFT)
  isActive        Boolean       @default(true)
  destinationId   String?
  amenities       String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  destination     Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  packages        TourPackage[]
  inquiries       CabInquiry[]

  @@index([vehicleType, status, isActive])
  @@index([destinationId])
  @@map("vehicles")
}

model CabInquiry {
  id             String           @id @default(cuid())
  vehicleId      String?
  name           String
  email          String
  phone          String
  pickupLocation String
  dropLocation   String
  pickupDate     DateTime
  tripType       CabTripType
  passengers     Int
  message        String?
  status         CabInquiryStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([vehicleId, status])
  @@map("cab_inquiries")
}

model TravelInquiry {
  id         String        @id @default(cuid())
  packageId  String
  name       String
  email      String
  phone      String
  travelDate DateTime
  adults     Int
  children   Int
  message    String?
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  package    TourPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([packageId, status])
  @@map("travel_inquiries")
}

model Blog {
  id                    String            @id @default(cuid())
  title                 String
  slug                  String            @unique
  excerpt               String
  content               String            @db.Text
  contentFormat         BlogContentFormat @default(JSON_BLOCKS)
  contentBlocks         Json?
  faq                   Json?
  featuredImage         String?
  featuredImagePublicId String?
  galleryImages         String[]
  authorId              String?
  isPublished           Boolean           @default(false)
  status                BlogStatus        @default(DRAFT)
  featured              Boolean           @default(false)
  viewCount             Int               @default(0)
  readingTimeMinutes    Int               @default(0)
  publishedAt           DateTime?
  seoTitle              String?
  seoDescription        String?
  canonicalUrl          String?
  ogImage               String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  author                BlogAuthor?       @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categories            BlogCategory[]
  tags                  BlogTag[]
  destinations          Destination[]
  packages              TourPackage[]

  @@index([isPublished, publishedAt])
  @@index([status, featured, publishedAt])
  @@index([authorId])
  @@map("blogs")
}

model BlogAuthor {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  bio       String?
  avatar    String?
  role      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@map("blog_authors")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]

  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@map("blog_tags")
}

model Media {
  id              String            @id @default(cuid())
  publicId        String            @unique
  url             String
  secureUrl       String
  resourceType    MediaResourceType @default(IMAGE)
  mimeType        String?
  format          String?
  folder          String?
  fileName        String?
  width           Int?
  height          Int?
  size            BigInt?
  durationSeconds Float?
  altText         String?
  caption         String?
  tags            String[]
  metadata        Json?
  createdBy       String?
  status          MediaStatus       @default(ACTIVE)
  usageCount      Int               @default(0)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  links           MediaLink[]

  @@index([resourceType, status])
  @@index([folder])
  @@index([createdBy])
  @@map("media")
}

model MediaLink {
  id        String        @id @default(cuid())
  mediaId   String
  module    MediaModule
  moduleId  String
  role      MediaLinkRole @default(GALLERY)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  media     Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([mediaId, module, moduleId, role])
  @@index([module, moduleId])
  @@index([mediaId])
  @@map("media_links")
}

model SeoMetadata {
  id           String   @id @default(cuid())
  pageType     String
  entityType   String?
  entityId     String?
  title        String
  description  String
  canonicalUrl String?
  ogImage      String?
  robots       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pageType, entityType, entityId])
  @@map("seo_metadata")
}

model LookupGroup {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       LookupItem[]

  @@map("lookup_groups")
}

model LookupItem {
  id          String      @id @default(cuid())
  groupId     String
  label       String
  value       String
  description String?
  icon        String?
  color       String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  group       LookupGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([groupId, value])
  @@index([groupId, isActive])
  @@map("lookup_items")
}

// Package pricing models (added to fix missing relations)
model PackageSeasonalPrice {
  id              String      @id @default(cuid())
  packageId       String
  label           String
  priceFrom       Decimal     @db.Decimal(12, 2)
  discountedPrice Decimal?    @db.Decimal(12, 2)
  displayOrder    Int         @default(0)
  startDate       DateTime
  endDate         DateTime
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  package         TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([packageId])
  @@map("package_seasonal_prices")
}

model PackageOffer {
  id              String      @id @default(cuid())
  packageId       String
  label           String
  badge           String?
  discountedPrice Decimal?    @db.Decimal(12, 2)
  priority        Int         @default(0)
  startDate       DateTime
  endDate         DateTime
  featured        Boolean     @default(false)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  package         TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([packageId])
  @@map("package_offers")
}

// Phase 16: Inquiry & Lead Management models
model Inquiry {
  id            String              @id @default(cuid())
  inquiryNumber String              @unique
  name          String
  email         String
  phone         String
  whatsapp      String?
  country       String?
  city          String?
  adults        Int                 @default(1)
  children      Int                 @default(0)
  travelDate    DateTime?
  budget        Decimal?            @db.Decimal(12, 2)
  message       String?
  source        InquirySource       @default(WEBSITE)
  type          InquiryType         @default(GENERAL)
  status        InquiryStatusNew    @default(NEW)
  priority      InquiryPriority     @default(MEDIUM)
  assignedTo    String?
  packageId     String?
  hotelId       String?
  cabId         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notes         InquiryNote[]
  activities    InquiryActivity[]
  assignments   InquiryAssignment[]

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([type])
  @@index([assignedTo])
  @@index([packageId])
  @@index([hotelId])
  @@index([cabId])
  @@index([createdAt])
  @@map("inquiries")
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  note      String   @db.Text
  createdBy String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([inquiryId])
  @@map("inquiry_notes")
}

model InquiryActivity {
  id        String   @id @default(cuid())
  inquiryId String
  action    String
  oldValue  String?
  newValue  String?
  createdBy String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
  @@map("inquiry_activities")
}

model InquiryAssignment {
  id         String   @id @default(cuid())
  inquiryId  String
  assignedTo String
  assignedBy String
  assignedAt DateTime @default(now())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([inquiryId])
  @@index([assignedTo])
  @@map("inquiry_assignments")
}
