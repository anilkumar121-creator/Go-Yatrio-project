# Environment
NODE_ENV=development

# Server & Network
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Initial Admin Seeding (Optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External Routing & Open-Source Map Providers (Step 184 Part 2)
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="GoYatrio/1.0 (+https://www.goyatrio.com)"
NOMINATIM_TIMEOUT_MS="5000"
NOMINATIM_CACHE_TTL_SECONDS=3600

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=GoYatrio
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

BOOKING_PENDING_PAYMENT_TIMEOUT_MINUTES=30
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@goyatrio.com