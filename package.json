{
  "name": "goyatrio",
  "version": "0.1.0",
  "private": true,
  "description": "GoYatrio enterprise monorepo foundation.",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @goyatrio/web dev",
    "dev:api": "pnpm --filter @goyatrio/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@next/eslint-plugin-next": "^15.5.23",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
